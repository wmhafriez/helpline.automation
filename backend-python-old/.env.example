# Copy this file to .env in this folder, then set local or staging service credentials.
# Use a separate test database so local experiments do not write to production data.
MONGODB_URI=mongodb://localhost:27017
DB_NAME=hispeedcity_local_test
JWT_SECRET=replace-with-a-long-random-local-secret
ADMIN_USERNAME=local-admin
ADMIN_PASSWORD=replace-with-a-strong-local-password
CORS_ORIGIN=*
MONGO_TIMEOUT_MS=5000

# Required by the legacy server's startup configuration. Add Cloudinary test credentials
# to exercise helpline photo uploads. Leave blank to test non-photo workflows only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
